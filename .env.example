# Build profile (optional)
# APP_ENV - environment label used for local/dev/prod separation.
APP_ENV=local
# APP_VERSION - build metadata version string.
APP_VERSION=3.0.3
# TARGET_PLATFORM - docker build platform (linux/arm64 or linux/amd64).
TARGET_PLATFORM=linux/arm64
# TZ - timezone used by services (defaults to Europe/Moscow).
TZ=Europe/Moscow
# HEALTH_ADDR - address for service health endpoints.
HEALTH_ADDR=0.0.0.0:8080

# Discord (required)
# DISCORD_TOKEN - bot token used to access Discord API.
DISCORD_TOKEN=replace_me
# DISCORD_CHANNEL_ID - channel ID to read messages from.
DISCORD_CHANNEL_ID=replace_me

# Telegram (required for telegram senders)
# TELEGRAM_BOT_TOKEN - bot token used to send messages.
TELEGRAM_BOT_TOKEN=replace_me
# TELEGRAM_WEEK_CHAT_ID - chat ID for week updates.
TELEGRAM_WEEK_CHAT_ID=replace_me
# TELEGRAM_GAME_CHAT_ID - chat ID for game images.
TELEGRAM_GAME_CHAT_ID=replace_me

# Kafka (required)
# KAFKA_BROKERS - comma-separated brokers list.
KAFKA_BROKERS=kafka:9092
# KAFKA_INPUT_TOPIC - listener output / processor input topic.
KAFKA_INPUT_TOPIC=discord-message-ids
# KAFKA_WEEK_TOPIC - processor output for week updates.
KAFKA_WEEK_TOPIC=discord-week-updates
# KAFKA_GAME_TOPIC - processor output for game updates.
KAFKA_GAME_TOPIC=discord-game-updates
# KAFKA_TELEGRAM_WEEK_TOPIC - week formatter output for telegram-ready messages.
KAFKA_TELEGRAM_WEEK_TOPIC=telegram-week-updates
# KAFKA_TELEGRAM_WEEK_SENDER_GROUP - consumer group for week telegram sender.
KAFKA_TELEGRAM_WEEK_SENDER_GROUP=discord-kafka-telegram-week-sender
# KAFKA_TELEGRAM_WEEK_SENDER_CLIENT_ID - client ID for week telegram sender.
KAFKA_TELEGRAM_WEEK_SENDER_CLIENT_ID=discord-kafka-telegram-week-sender
# KAFKA_PARTITIONS - topic partitions for init.
KAFKA_PARTITIONS=1
# KAFKA_REPLICATION_FACTOR - topic replication factor for init.
KAFKA_REPLICATION_FACTOR=1
# KAFKA_CLIENT_ID - optional client ID used by Kafka producers.
KAFKA_CLIENT_ID=discord-kafka-listener
# KAFKA_CONSUMER_GROUP - optional consumer group for processor.
KAFKA_CONSUMER_GROUP=discord-kafka-processor
# KAFKA_WEEK_CLIENT_ID - optional client ID for week formatter.
KAFKA_WEEK_CLIENT_ID=discord-kafka-week-formatter
# KAFKA_WEEK_CONSUMER_GROUP - optional consumer group for week formatter.
KAFKA_WEEK_CONSUMER_GROUP=discord-kafka-week-formatter
# KAFKA_TELEGRAM_GAME_SENDER_GROUP - consumer group for game telegram sender.
KAFKA_TELEGRAM_GAME_SENDER_GROUP=discord-kafka-telegram-game-sender
# KAFKA_TELEGRAM_GAME_SENDER_CLIENT_ID - client ID for game telegram sender.
KAFKA_TELEGRAM_GAME_SENDER_CLIENT_ID=discord-kafka-telegram-game-sender
# KAFKA_WRITE_TIMEOUT - optional write timeout.
KAFKA_WRITE_TIMEOUT=5s
# KAFKA_READ_TIMEOUT - optional read wait for consumer fetch.
KAFKA_READ_TIMEOUT=10s
# MESSAGE_BUFFER_SIZE - optional buffer for listener.
MESSAGE_BUFFER_SIZE=256

# Discord processor tuning (optional)
# DISCORD_HEALTH_INTERVAL - API health check interval.
DISCORD_HEALTH_INTERVAL=1m
# DISCORD_EMBED_WARMUP - how long to wait for embeds to populate.
DISCORD_EMBED_WARMUP=5s
# DISCORD_FETCH_MAX_ATTEMPTS - max fetch attempts per message.
DISCORD_FETCH_MAX_ATTEMPTS=10
# DISCORD_FETCH_RETRY_DELAY - delay between fetch attempts.
DISCORD_FETCH_RETRY_DELAY=2s
# DISCORD_FETCH_TIMEOUT - timeout per fetch request.
DISCORD_FETCH_TIMEOUT=10s

# Postgres (required for processor & week formatter)
# POSTGRES_HOST - postgres host or service name.
POSTGRES_HOST=postgres
# POSTGRES_PORT - postgres port inside the network.
POSTGRES_PORT=5432
# POSTGRES_EXPOSE_PORT - optional host port mapping for local access.
POSTGRES_EXPOSE_PORT=5432
# POSTGRES_USER - database user.
POSTGRES_USER=megagames
# POSTGRES_PASSWORD - database password.
POSTGRES_PASSWORD=megagames
# POSTGRES_DB - database name.
POSTGRES_DB=megagames
# POSTGRES_SSLMODE - postgres sslmode (disable/require/etc).
POSTGRES_SSLMODE=disable
# POSTGRES_CONNECT_TIMEOUT - initial connect timeout.
POSTGRES_CONNECT_TIMEOUT=5s
# POSTGRES_CONNECT_RETRY_DELAY - delay between connect attempts.
POSTGRES_CONNECT_RETRY_DELAY=2s
# POSTGRES_CONNECT_MAX_ATTEMPTS - max connect attempts.
POSTGRES_CONNECT_MAX_ATTEMPTS=30

# Processor retry policy (optional)
# PROCESS_MAX_ATTEMPTS - max processing attempts before moving to failed.
PROCESS_MAX_ATTEMPTS=10
# PROCESS_RETRY_INTERVAL - interval to reprocess pending messages.
PROCESS_RETRY_INTERVAL=1m

# Game image pipeline (required)
# KAFKA_GAME_IMAGE_TOPIC - game image output topic.
KAFKA_GAME_IMAGE_TOPIC=discord-game-images
# KAFKA_GAME_IMAGE_CLIENT_ID - optional client ID for game image service.
KAFKA_GAME_IMAGE_CLIENT_ID=discord-kafka-game-image
# KAFKA_GAME_IMAGE_CONSUMER_GROUP - optional consumer group for game image service.
KAFKA_GAME_IMAGE_CONSUMER_GROUP=discord-kafka-game-image

# MongoDB (required for game image service)
# MONGO_URI - connection string to MongoDB.
MONGO_URI=mongodb://megagames:megagames@mongo:27017/?authSource=admin
# MONGO_DB - database name.
MONGO_DB=megagames
# MONGO_COLLECTION - main collection for game image statuses.
MONGO_COLLECTION=game_images
# MONGO_FAILED_COLLECTION - collection for failed messages.
MONGO_FAILED_COLLECTION=game_images_failed
# MONGO_ROOT_USER - root username for mongo container.
MONGO_ROOT_USER=megagames
# MONGO_ROOT_PASSWORD - root password for mongo container.
MONGO_ROOT_PASSWORD=megagames
# MONGO_EXPOSE_PORT - optional host port mapping for local access.
MONGO_EXPOSE_PORT=27017
# MONGO_CONNECT_TIMEOUT - initial connect timeout.
MONGO_CONNECT_TIMEOUT=5s
# MONGO_CONNECT_RETRY_DELAY - delay between connect attempts.
MONGO_CONNECT_RETRY_DELAY=2s
# MONGO_CONNECT_MAX_ATTEMPTS - max connect attempts.
MONGO_CONNECT_MAX_ATTEMPTS=30

# MinIO (required for game image service)
# MINIO_ENDPOINT - host:port for MinIO (no scheme).
MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY - access key for MinIO.
MINIO_ACCESS_KEY=megagames
# MINIO_SECRET_KEY - secret key for MinIO.
MINIO_SECRET_KEY=megagames
# MINIO_BUCKET - bucket name for game images.
MINIO_BUCKET=game-images
# MINIO_REGION - MinIO region for bucket creation.
MINIO_REGION=us-east-1
# MINIO_USE_SSL - set true if MinIO uses TLS.
MINIO_USE_SSL=false
# MINIO_PUBLIC_URL - public base URL for building file links (optional).
MINIO_PUBLIC_URL=http://localhost:9000
# MINIO_OBJECT_PREFIX - object key prefix inside bucket.
MINIO_OBJECT_PREFIX=game-recaps
# MINIO_UPLOAD_TIMEOUT - upload timeout for image files.
MINIO_UPLOAD_TIMEOUT=30s
# MINIO_CONNECT_TIMEOUT - initial connect timeout.
MINIO_CONNECT_TIMEOUT=5s
# MINIO_CONNECT_RETRY_DELAY - delay between connect attempts.
MINIO_CONNECT_RETRY_DELAY=2s
# MINIO_CONNECT_MAX_ATTEMPTS - max connect attempts.
MINIO_CONNECT_MAX_ATTEMPTS=30
# MINIO_EXPOSE_PORT - optional host port mapping for MinIO API.
MINIO_EXPOSE_PORT=9000
# MINIO_CONSOLE_PORT - optional host port mapping for MinIO console.
MINIO_CONSOLE_PORT=9001

# Game image fetcher (optional)
# GAME_IMAGE_FETCHER_TYPE - headless|gochrome|selenium.
GAME_IMAGE_FETCHER_TYPE=headless
# NEON_BASE_URL - base URL for game pages.
NEON_BASE_URL=https://neonsportz.com
# NEON_LEAGUE - league slug for game URLs.
NEON_LEAGUE=MEGA
# GAME_IMAGE_FETCH_TIMEOUT - timeout for fetching a single game image.
GAME_IMAGE_FETCH_TIMEOUT=2m
# GOCHROME_HEADLESS - enable headless mode for gochrome.
GOCHROME_HEADLESS=true
# SELENIUM_URL - selenium endpoint (required if GAME_IMAGE_FETCHER_TYPE=selenium).
SELENIUM_URL=http://selenium-chrome:4444/wd/hub
# SELENIUM_DOWNLOAD_DIR - shared download directory for selenium.
SELENIUM_DOWNLOAD_DIR=/home/seluser/Downloads
# COMPOSE_PROFILES - enable selenium profile if selenium fetcher is used.
COMPOSE_PROFILES=
