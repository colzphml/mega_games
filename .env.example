# Build profile (optional)
# APP_ENV - environment label used for local/dev/prod separation.
APP_ENV=local
# APP_VERSION - build metadata version string.
APP_VERSION=0.1
# TARGET_PLATFORM - docker build platform (linux/arm64 or linux/amd64).
TARGET_PLATFORM=linux/arm64
# TZ - timezone used by services (defaults to Europe/Moscow).
TZ=Europe/Moscow
# HEALTH_ADDR - address for service health endpoints.
HEALTH_ADDR=0.0.0.0:8080

# Discord (required)
# DISCORD_TOKEN - bot token used to access Discord API.
DISCORD_TOKEN=replace_me
# DISCORD_CHANNEL_ID - channel ID to read messages from.
DISCORD_CHANNEL_ID=replace_me

# Kafka (required)
# KAFKA_BROKERS - comma-separated brokers list.
KAFKA_BROKERS=kafka:9092
# KAFKA_INPUT_TOPIC - listener output / processor input topic.
KAFKA_INPUT_TOPIC=discord-message-ids
# KAFKA_WEEK_TOPIC - processor output for week updates.
KAFKA_WEEK_TOPIC=discord-week-updates
# KAFKA_GAME_TOPIC - processor output for game updates.
KAFKA_GAME_TOPIC=discord-game-updates
# KAFKA_PARTITIONS - topic partitions for init.
KAFKA_PARTITIONS=1
# KAFKA_REPLICATION_FACTOR - topic replication factor for init.
KAFKA_REPLICATION_FACTOR=1
# KAFKA_CLIENT_ID - optional client ID used by Kafka producers.
KAFKA_CLIENT_ID=discord-kafka-listener
# KAFKA_CONSUMER_GROUP - optional consumer group for processor.
KAFKA_CONSUMER_GROUP=discord-kafka-processor
# KAFKA_WRITE_TIMEOUT - optional write timeout.
KAFKA_WRITE_TIMEOUT=5s
# KAFKA_READ_TIMEOUT - optional read wait for consumer fetch.
KAFKA_READ_TIMEOUT=10s
# MESSAGE_BUFFER_SIZE - optional buffer for listener.
MESSAGE_BUFFER_SIZE=256

# Discord processor tuning (optional)
# DISCORD_HEALTH_INTERVAL - API health check interval.
DISCORD_HEALTH_INTERVAL=1m
# DISCORD_EMBED_WARMUP - how long to wait for embeds to populate.
DISCORD_EMBED_WARMUP=5s
# DISCORD_FETCH_MAX_ATTEMPTS - max fetch attempts per message.
DISCORD_FETCH_MAX_ATTEMPTS=10
# DISCORD_FETCH_RETRY_DELAY - delay between fetch attempts.
DISCORD_FETCH_RETRY_DELAY=2s
# DISCORD_FETCH_TIMEOUT - timeout per fetch request.
DISCORD_FETCH_TIMEOUT=10s

# Postgres (required for processor)
# POSTGRES_HOST - postgres host or service name.
POSTGRES_HOST=postgres
# POSTGRES_PORT - postgres port inside the network.
POSTGRES_PORT=5432
# POSTGRES_EXPOSE_PORT - optional host port mapping for local access.
POSTGRES_EXPOSE_PORT=5432
# POSTGRES_USER - database user.
POSTGRES_USER=megagames
# POSTGRES_PASSWORD - database password.
POSTGRES_PASSWORD=megagames
# POSTGRES_DB - database name.
POSTGRES_DB=megagames
# POSTGRES_SSLMODE - postgres sslmode (disable/require/etc).
POSTGRES_SSLMODE=disable
# POSTGRES_CONNECT_TIMEOUT - initial connect timeout.
POSTGRES_CONNECT_TIMEOUT=5s
# POSTGRES_CONNECT_RETRY_DELAY - delay between connect attempts.
POSTGRES_CONNECT_RETRY_DELAY=2s
# POSTGRES_CONNECT_MAX_ATTEMPTS - max connect attempts.
POSTGRES_CONNECT_MAX_ATTEMPTS=30

# Processor retry policy (optional)
# PROCESS_MAX_ATTEMPTS - max processing attempts before moving to failed.
PROCESS_MAX_ATTEMPTS=10
# PROCESS_RETRY_INTERVAL - interval to reprocess pending messages.
PROCESS_RETRY_INTERVAL=1m
