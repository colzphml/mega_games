@startuml
package "Client Layer" {
    [Client] 
}

package "API Layer" {
    [API Gateway]
}

package "Command Side" {
    [Command Service] 
    [Command Handler] 
    [Write Database] 
}

package "Query Side" {
    [Query Service] 
    [Query Handler] 
    [Read Database] 
}

package "Event Layer" {
    [Event Store] 
}

Client --> [API Gateway] : send Command/Query
[API Gateway] --> [Command Service] : forward Command
[API Gateway] --> [Query Service] : forward Query
[Command Service] --> [Command Handler] : handle Command
[Command Handler] --> [Write Database] : write data
[Command Handler] --> [Event Store] : save Event
[Event Store] --> [Query Service] : publish Event
[Query Service] --> [Query Handler] : handle Query
[Query Handler] --> [Read Database] : read data
[Query Service] --> [API Gateway] : return Query Result
[API Gateway] --> Client : return Result