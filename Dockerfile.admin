FROM --platform=$BUILDPLATFORM golang:1.25.5-alpine AS builder

SHELL ["/bin/sh", "-c"]

ARG TARGETOS
ARG TARGETARCH
ARG TZ=Europe/Moscow

ENV TZ=$TZ

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git tzdata

# Copy go mod and sum files
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the admin panel for the target platform selected by buildx/compose.
RUN set -eu; \
    GOOS="${TARGETOS:-linux}"; \
    GOARCH="${TARGETARCH:-amd64}"; \
    CGO_ENABLED=0 GOOS="$GOOS" GOARCH="$GOARCH" \
    go build -o admin-panel ./cmd/admin_panel/main.go

# Final stage
FROM alpine:3.21

# Set timezone
ARG TZ=Europe/Moscow
ENV TZ=$TZ
RUN apk add --no-cache tzdata

# Create app user
RUN adduser -D -u 1000 app
USER app

WORKDIR /app

# Copy binary
COPY --from=builder /app/admin-panel /app/admin-panel

# Copy assets and templates
COPY cmd/admin_panel/assets /app/cmd/admin_panel/assets
COPY cmd/admin_panel/templates /app/cmd/admin_panel/templates

EXPOSE 8081

ENTRYPOINT ["/app/admin-panel"]
